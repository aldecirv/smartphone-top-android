<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Top.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="TextAppearance.Top.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Top.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.Top.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.Top.BodyStrong" parent="TextAppearance.Top.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.Top.Caption" parent="TextAppearance.Top.Body">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="TextAppearance.Top.Label" parent="TextAppearance.Top.Caption">
        <item name="android:textSize">9.5sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Top.Mono" parent="TextAppearance.Top.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Top.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Top.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Widget.Top.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>
    <style name="Widget.Top.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand</item>
    </style>
    <style name="Widget.Top.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
    <style name="Widget.Top.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/card</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">10.5sp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">32dp</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
