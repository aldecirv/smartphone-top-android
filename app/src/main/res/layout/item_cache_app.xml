<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Top.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <CheckBox
            android:id="@+id/selectBox"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand"
            android:clickable="false"
            android:focusable="false" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="38dp"
            android:layout_height="38dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/TextAppearance.Top.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/packageName"
                style="@style/TextAppearance.Top.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/cache"
                style="@style/TextAppearance.Top.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/details"
                style="@style/TextAppearance.Top.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/status"
                style="@style/TextAppearance.Top.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/emerald"
                android:textSize="9sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clean"
            style="@style/Widget.Top.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="Esvaziar"
            android:textSize="8.5sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
