<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/TextAppearance.Top.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CENTRAL DE CACHE"
            android:textColor="@color/blue" />

        <TextView
            style="@style/TextAppearance.Top.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Limpeza de cache"
            android:textSize="24sp" />

        <TextView
            style="@style/TextAppearance.Top.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cache real por app via StorageStatsManager. A limpeza é assistida pelas configurações oficiais do Android — sem root, ADB ou acessibilidade."
            android:textSize="10sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permissionCard"
            style="@style/Widget.Top.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:strokeColor="#66F59E0B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="11dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/amber" />

                    <TextView
                        style="@style/TextAppearance.Top.BodyStrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Acesso a Dados de Uso necessário"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Top.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sem essa permissão especial o Android não mostra o cache de cada aplicativo."
                    android:textSize="9.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantUsage"
                    style="@style/Widget.Top.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:text="Conceder acesso"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/TextAppearance.Top.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cache medido"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/totalCache"
                    style="@style/TextAppearance.Top.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 B"
                    android:textColor="@color/blue"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/TextAppearance.Top.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps analisados"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/appCount"
                    style="@style/TextAppearance.Top.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/purple"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/TextAppearance.Top.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Com cache"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/withCacheCount"
                    style="@style/TextAppearance.Top.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/emerald"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/lastAnalysis"
            style="@style/TextAppearance.Top.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nenhuma análise realizada ainda"
            android:textSize="9.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Widget.Top.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_button"
                android:text="Analisar todos"
                android:textSize="10.5sp"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyButton"
                style="@style/Widget.Top.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="Histórico"
                android:textSize="9.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cleanAllButton"
            style="@style/Widget.Top.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/rose"
            android:text="Esvaziar cache de todos"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectAll"
                style="@style/Widget.Top.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:text="Selecionar todos"
                android:textSize="9sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deselectAll"
                style="@style/Widget.Top.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:text="Desmarcar"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/selectedCount"
                style="@style/TextAppearance.Top.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0 selecionado(s)"
                android:textSize="9sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cleanSelectedButton"
            style="@style/Widget.Top.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Esvaziar cache dos selecionados"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mediaShortcut"
            style="@style/Widget.Top.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:text="Mídia e arquivos  →"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/blue"
            android:progressBackgroundTint="@color/card_alt"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            style="@style/TextAppearance.Top.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="9sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_clean"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/emptyTitle"
            style="@style/TextAppearance.Top.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nada analisado ainda" />

        <TextView
            style="@style/TextAppearance.Top.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Toque em Analisar todos para consultar os apps instalados." />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
