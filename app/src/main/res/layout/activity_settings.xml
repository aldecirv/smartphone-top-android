<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.Top.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Ajustes"
            android:textSize="17sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextAppearance.Top.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSÕES"
                android:textColor="@color/brand" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Top.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_storage"
                            app:tint="@color/blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Top.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acesso a Dados de Uso"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/usageStatus"
                                style="@style/TextAppearance.Top.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Necessário para medir o cache" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/usageButton"
                            style="@style/Widget.Top.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:text="Abrir"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_image"
                            app:tint="@color/purple" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Top.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acesso à mídia"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/mediaStatus"
                                style="@style/TextAppearance.Top.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Para listar fotos, vídeos e áudios" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mediaButton"
                            style="@style/Widget.Top.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:text="Permitir"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Top.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="AVISO DE ARMAZENAMENTO"
                android:textColor="@color/amber" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Top.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/thresholdLabel"
                        style="@style/TextAppearance.Top.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avisar a partir de 85%"
                        android:textSize="12.5sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/thresholdSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:valueFrom="50"
                        android:valueTo="95"
                        android:stepSize="5"
                        android:value="85" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Top.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DADOS"
                android:textColor="@color/rose" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Top.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:id="@+id/clearHistoryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/rose" />

                    <TextView
                        style="@style/TextAppearance.Top.BodyStrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:text="Limpar histórico de limpezas"
                        android:textColor="@color/rose"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Top.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SOBRE"
                android:textColor="@color/text_tertiary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Top.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Top.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smartphone Top 1.0.0"
                        android:textSize="12.5sp" />

                    <TextView
                        style="@style/TextAppearance.Top.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Leituras reais de armazenamento, RAM, bateria e apps. Sem internet, sem anúncios, sem conta e sem métricas inventadas."
                        android:textSize="10.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openAppSettings"
                        style="@style/Widget.Top.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="9dp"
                        android:text="Abrir configurações do app"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
